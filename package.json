{
  "name": "screenplay-web",
  "version": "0.2.0",
  "description": "基于 Fountain 的网页剧本编辑器：多剧本、实时预览、场景对比、git 修改历史，手机电脑都能用",
  "scripts": {
    "build": "esbuild src/vendor.js --bundle --format=esm --minify --outfile=public/vendor.bundle.js",
    "start": "node server.js",
    "postinstall": "npm run build"
  },
  "keywords": [
    "screenplay",
    "fountain",
    "screenwriting",
    "editor"
  ],
  "author": "duanxuan1230",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "fountain-js": "^1.2.4",
    "marked": "^18.0.14"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duanxuan1230/screenplay-web.git"
  },
  "homepage": "https://github.com/duanxuan1230/screenplay-web",
  "bugs": {
    "url": "https://github.com/duanxuan1230/screenplay-web/issues"
  }
}
